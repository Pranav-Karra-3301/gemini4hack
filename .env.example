# Copy to .env at the repo root (and into each worktree). Never commit .env.
GEMINI_API_KEY=
# Fallback for regions and scoring when the Gemini key fails
OPENROUTER_API_KEY=
# Live spend cap: at most this many Live session starts (token mints + browser sessions) per
# window; over it Core answers 429. 0 turns the cap off.
LIVE_MAX_STARTS=20
LIVE_BUDGET_WINDOW_MIN=10
