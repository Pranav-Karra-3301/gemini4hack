{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/gh-inbox --hook", "timeout": 20 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/gh-inbox --hook", "timeout": 20 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/gh-inbox:*)",
      "Bash(./scripts/gh-inbox:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(git worktree:*)",
      "Bash(git fetch:*)"
    ]
  }
}
